<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="O vídeo sai do celular e entra diretamente no YouTube. Nenhum servidor HostStorm participa da transmissão."
            android:textColor="@color/storm_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Chave de transmissão do YouTube"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/streamKeyInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_field"
            android:hint="xxxx-xxxx-xxxx-xxxx-xxxx"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textColorHint="#7F8AA8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="URL RTMPS do YouTube"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/serverInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_field"
            android:hint="rtmps://a.rtmps.youtube.com:443/live2"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textColorHint="#7F8AA8" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="A chave fica salva somente neste aparelho. Para maior segurança, use uma chave personalizada criada na Sala de Controle ao Vivo do YouTube."
            android:textColor="@color/storm_muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>

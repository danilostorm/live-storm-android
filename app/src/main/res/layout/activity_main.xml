<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_preview_fallback"
    android:fitsSystemWindows="true">

    <SurfaceView
        android:id="@+id/cameraPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:keepScreenOn="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/screenModeBackdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_games_preview"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/screenModeOverlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:background="@drawable/bg_glass_card"
        android:gravity="center"
        android:paddingStart="22dp"
        android:paddingTop="20dp"
        android:paddingEnd="22dp"
        android:paddingBottom="20dp"
        android:text="MODO GAMES PRONTO&#10;&#10;Ao iniciar, o Android solicitará autorização para transmitir a tela. Depois abra o jogo normalmente."
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.42" />

    <View
        android:id="@+id/topScrim"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:background="@drawable/bg_top_scrim"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/bottomScrim"
        android:layout_width="0dp"
        android:layout_height="300dp"
        android:background="@drawable/bg_bottom_scrim"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/focusIndicator"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_focus_indicator"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:adjustViewBounds="true"
            android:contentDescription="Live Storm"
            android:scaleType="centerCrop"
            android:src="@drawable/app_logo_badge" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="LIVE STORM"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="YOUTUBE DIRECT"
                android:textColor="@color/storm_muted"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusPill"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_status_idle"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="● PRONTO"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settingsButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="9dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Configurações de transmissão"
            android:gravity="center"
            android:text="⚙"
            android:textColor="@color/white"
            android:textSize="21sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/statsCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <TextView
            android:id="@+id/liveTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textColor="@color/white"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/uploadBitrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Upload -- Mb/s"
            android:textColor="@color/storm_green"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/encoderFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="FPS real --"
            android:textColor="@color/storm_green"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/profileSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="NORMAL • 1080p • 60 FPS • AUTO"
            android:textColor="@color/storm_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cameraTools"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="18dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintVertical_bias="0.48">

        <TextView
            android:id="@+id/switchCameraButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Trocar câmera"
            android:gravity="center"
            android:text="↺"
            android:textColor="@color/white"
            android:textSize="25sp" />

        <TextView
            android:id="@+id/micButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Microfone"
            android:gravity="center"
            android:text="MIC"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/moreOptionsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Mais opções"
            android:gravity="center"
            android:text="•••"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/flashButton"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/zoomLabel"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/proButton"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/overlayButton"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/hudToggleButton"
        android:layout_width="58dp"
        android:layout_height="38dp"
        android:layout_marginStart="18dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="Ocultar informações da tela"
        android:elevation="12dp"
        android:gravity="center"
        android:text="HUD−"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="18dp" />

    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Painel da transmissão"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/capabilityHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:text="Pronto para configurar"
                    android:textColor="@color/storm_muted"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/connectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COLE SUA CHAVE"
                android:textColor="@color/storm_warning"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/normalModeButton"
                style="@style/StreamChip"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="NORMAL • CÂMERA" />

            <TextView
                android:id="@+id/gamesModeButton"
                style="@style/StreamChip"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="GAMES • TELA" />
        </LinearLayout>

        <TextView
            android:id="@+id/broadcastModeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="2"
            android:text="Live normal com câmera e controles profissionais."
            android:textColor="@color/storm_muted"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/qualityToggleButton"
            style="@style/StreamChip"
            android:layout_width="match_parent"
            android:layout_marginTop="9dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="1080p • 60 FPS • AUTO    AJUSTAR" />

        <LinearLayout
            android:id="@+id/qualityOptionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/resolution720Button"
                        style="@style/StreamChip"
                        android:text="720p" />

                    <TextView
                        android:id="@+id/resolution1080Button"
                        style="@style/StreamChip"
                        android:layout_marginStart="7dp"
                        android:text="1080p" />

                    <TextView
                        android:id="@+id/fps30Button"
                        style="@style/StreamChip"
                        android:layout_marginStart="12dp"
                        android:text="30 FPS" />

                    <TextView
                        android:id="@+id/fps60Button"
                        style="@style/StreamChip"
                        android:layout_marginStart="7dp"
                        android:text="60 FPS" />
                </LinearLayout>
            </HorizontalScrollView>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/autoOrientationButton"
                        style="@style/StreamChip"
                        android:text="AUTO" />

                    <TextView
                        android:id="@+id/portraitOrientationButton"
                        style="@style/StreamChip"
                        android:layout_marginStart="7dp"
                        android:text="RETRATO 9:16" />

                    <TextView
                        android:id="@+id/landscapeOrientationButton"
                        style="@style/StreamChip"
                        android:layout_marginStart="7dp"
                        android:text="PAISAGEM 16:9" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <TextView
            android:id="@+id/gameAudioButton"
            style="@style/StreamChip"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="ÁUDIO: JOGO + MICROFONE"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/recordButton"
                style="@style/StreamChip"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="● REC LOCAL" />

            <TextView
                android:id="@+id/panelMoreOptionsButton"
                style="@style/StreamChip"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="MAIS OPÇÕES" />
        </LinearLayout>

        <TextView
            android:id="@+id/startStopButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="11dp"
            android:background="@drawable/bg_live_button"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="●  INICIAR LIVE NORMAL"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/preparingProgress"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:indeterminateTint="@color/storm_purple"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
